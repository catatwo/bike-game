; Engine configuration file.
config_version=5

[application]

config/name="bike-game"
config/use_custom_user_dir=true
config/custom_user_dir_name="bike-game"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/low_processor_mode=false
boot_splash/show_image=false
boot_splash/bg_color=Color(0.01, 0.02, 0.04, 1)

[audio]

driver/output_latency=30

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.01, 0.02, 0.04, 1)
